# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (Neon in production).
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/food_api?schema=public"

# Upstash Redis, used by the rate limiter so the limit is shared across all
# serverless instances. Leave both unset to fall back to the in-memory limiter
# (fine for local development, per-instance only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
