# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (Neon in production).
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/food_api?schema=public"

# Upstash Redis, used by the rate limiter so the limit is shared across all
# serverless instances. These names are the ones the Vercel KV / Upstash
# integration (Vercel Marketplace) sets automatically on the project; copy them
# from the Vercel dashboard or the Upstash console to use Upstash locally.
# Leave both unset to fall back to the in-memory limiter (fine for local
# development, per-instance only).
KV_REST_API_URL=
KV_REST_API_TOKEN=
